generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     Int                     @id @default(autoincrement())
  name                   String
  email                  String                  @unique
  passwordHash           String
  role                   Role
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  orders                 Order[]
  orderStatusHistories   OrderStatusHistory[]
  paymentsReceived       Payment[]
  pickupDeliveryRequests PickupDeliveryRequest[]
}

enum Role {
  ADMIN
  STAFF
}

model Customer {
  id         Int         @id @default(autoincrement())
  name       String
  phone      String      @unique
  address    String?
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  membership Membership?
  orders     Order[]
}

model Membership {
  id              Int      @id @default(autoincrement())
  customerId      Int      @unique
  customer        Customer @relation(fields: [customerId], references: [id])
  memberCode      String   @unique
  discountPercent Decimal  @default(10)
  isActive        Boolean  @default(true)
  joinedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Service {
  id         Int             @id @default(autoincrement())
  name       String
  category   ServiceCategory
  unit       ServiceUnit
  price      Decimal         @db.Decimal(12, 2)
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  orderItems OrderItem[]
}

enum ServiceUnit {
  KG
  SATUAN
}

enum ServiceCategory {
  REGULER
  EKSPRESS
  KHUSUS
}

model Order {
  id                   Int                  @id @default(autoincrement())
  orderCode            String               @unique
  customerId           Int
  customer             Customer             @relation(fields: [customerId], references: [id])
  createdById          Int
  user                 User                 @relation(fields: [createdById], references: [id])
  orderStatus          OrderStatus          @default(PESANAN_DITERIMA)
  paymentStatus        PaymentStatus        @default(BELUM_DIBAYAR)
  subtotal             Decimal              @db.Decimal(12, 2)
  discount             Decimal              @default(0) @db.Decimal(12, 2)
  total                Decimal              @db.Decimal(12, 2)
  dueAt                DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  orderItems           OrderItem[]
  payment              Payment?
  orderStatusHistories OrderStatusHistory[]
}

enum PaymentStatus {
  BELUM_DIBAYAR
  SUDAH_DIBAYAR
}

enum OrderStatus {
  PESANAN_DITERIMA
  DICUCI
  DIKERINGKAN
  DISETRIKA
  SIAP_DIAMBIL
  SELESAI
  DIBATALKAN
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id])
  serviceId     Int
  service       Service  @relation(fields: [serviceId], references: [id])
  quantity      Float
  priceSnapshot Decimal  @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Payment {
  id           Int           @id @default(autoincrement())
  orderId      Int           @unique
  order        Order         @relation(fields: [orderId], references: [id])
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  paidAt       DateTime      @default(now())
  receivedById Int
  receivedBy   User          @relation(fields: [receivedById], references: [id])
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

model OrderStatusHistory {
  id          Int         @id @default(autoincrement())
  orderId     Int
  order       Order       @relation(fields: [orderId], references: [id])
  orderStatus OrderStatus
  changedById Int
  user        User        @relation(fields: [changedById], references: [id])
  changedAt   DateTime    @default(now())
  note        String?
}

model PickupDeliveryRequest {
  id            Int                  @id @default(autoincrement())
  name          String
  phone         String
  address       String
  type          PickupDeliveryType
  status        PickupDeliveryStatus @default(PENDING)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  processedAt   DateTime?
  processedById Int?
  processedBy   User?                @relation(fields: [processedById], references: [id])
}

enum PickupDeliveryType {
  PICKUP
  DELIVERY
}

enum PickupDeliveryStatus {
  PENDING
  ACCEPTED
  REJECTED
}
